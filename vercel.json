{
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "howtostopjunkmail.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/go/incogni",
      "destination": "https://deal.incogni.io/aff_c?offer_id=2&aff_id=2443",
      "permanent": false
    },
    {
      "source": "/go/deleteme",
      "destination": "https://joindeleteme.com",
      "permanent": false
    },
    {
      "source": "/go/optery",
      "destination": "https://optery.com",
      "permanent": false
    }
  ]
}
